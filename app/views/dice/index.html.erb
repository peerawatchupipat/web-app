<h1>Hello, Dice World!</h1>

<%dice1 = rand(1..6)%>
<%dice2 = rand(1..6)%>

<%total = dice1 + dice2%>
<ul>
    <li><%= "The total is: #{total}" %></li>
    <li><img src="/images/dice/<%= dice1 %>.svg" alt=""></li>
    <li><img src="/images/dice/<%= dice2 %>.svg" alt=""></li>
</ul>

<p>
<a href="/dice">Roll Again</a>

</p>