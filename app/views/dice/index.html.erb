<h1>Hello, Dice World!</h1>

<%dice1 = rand(1..6)%>
<%dice2 = rand(1..6)%>

<%total = dice1 + dice2%>
<ul>
    <li><%= "The total is: #{total}" %></li>
    <li><%= "Dice #1: #{dice1}" %></li>
    <li><%= "Dice #2: #{dice2}"%></li>
</ul>

<p>
<a href="/dice">Roll Again</a>
<img src="https://en.wikipedia.org/wiki/Dice#/media/File:6sided_dice_(cropped).jpg" alt="">
</p>